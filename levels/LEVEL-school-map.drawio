<mxfile host="app.diagrams.net"><diagram name="Game map" id="map"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Mary, last day of school (stage key: school) — game map&lt;/b&gt;&lt;br&gt;Five square rooms, four views each, in turning order (right arrow). Arrows are doorways, all drawn open; the label says the view you arrive facing. Red = locked at the start." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1040" height="50" as="geometry"/></mxCell>

<mxCell id="rc" value="Classroom 5H (linear opening: teaches tap, turn, pick up, read)" style="swimlane;startSize=24;fillColor=#fff2cc;strokeColor=#d6b656;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="330" height="210" as="geometry"/></mxCell>
<mxCell id="c1" value="c1 whiteboard wall&lt;br&gt;picture key to the timetable; supplies cupboard; Mr Hollis's desk" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rc"><mxGeometry x="10" y="34" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="c2" value="c2 window wall&lt;br&gt;bean plants, the moth watching; quiet wall" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rc"><mxGeometry x="170" y="34" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="c3" value="c3 door wall&lt;br&gt;open door to corridor; coat pegs; lost property; bin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rc"><mxGeometry x="10" y="124" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;c4 timetable wall — START&lt;/b&gt;&lt;br&gt;Mary's desk + envelope; timetable; Nutmeg (notebook); clock 2:40" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="rc"><mxGeometry x="170" y="124" width="150" height="70" as="geometry"/></mxCell>

<mxCell id="rl" value="Library" style="swimlane;startSize=24;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="330" height="210" as="geometry"/></mxCell>
<mxCell id="ln" value="ln Science + Music shelves&lt;br&gt;The Night Sky (note A); Music gap + sticky note (B); globe" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rl"><mxGeometry x="10" y="34" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="le" value="le window + storytime chair&lt;br&gt;quiet wall (knitted hamster)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rl"><mxGeometry x="170" y="34" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="ls" value="ls entrance + Mrs Ng's desk&lt;br&gt;open doorway back; BACK SOON card" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rl"><mxGeometry x="10" y="124" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="lw" value="lw Art shelf, trolley, Stories&lt;br&gt;The Painting Book (note C); Playing the Piano (page, B); four stories spell NANA" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rl"><mxGeometry x="170" y="124" width="150" height="70" as="geometry"/></mxCell>

<mxCell id="rh" value="Corridor (the hub: all three trails open from here)" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="330" height="210" as="geometry"/></mxCell>
<mxCell id="h1" value="&lt;b&gt;h1 lockers — GOAL&lt;/b&gt;&lt;br&gt;Mary's purple locker, three number dials (4 3 6)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="rh"><mxGeometry x="10" y="34" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="h2" value="h2 library doors&lt;br&gt;open doorway to library; fountain; trophy cabinet" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rh"><mxGeometry x="170" y="34" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="h3" value="h3 notice board + hall doorway&lt;br&gt;bonus riddle card (Night Moth)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rh"><mxGeometry x="10" y="124" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="h4" value="h4 doorways to 5H and art room&lt;br&gt;bunting" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rh"><mxGeometry x="170" y="124" width="150" height="70" as="geometry"/></mxCell>

