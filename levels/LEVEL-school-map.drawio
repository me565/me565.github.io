<mxfile host="app.diagrams.net"><diagram name="Floor plan" id="map"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Mary, last day of school — floor plan&lt;/font&gt;&lt;/b&gt;&lt;br&gt;North is up. A room's four views in turning order run north → east → south → west. White tabs are open doorways; the arrow says the walk and the view you arrive facing (away from the door). Red = locked at the start, green = where the child starts." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="10" width="1120" height="70" as="geometry"/></mxCell>
