<mxCell id="d2" value="5H doorway → c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" source="h4" target="c1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
