<mxCell id="d4" value="doorway → h4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" source="ls" target="h4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
