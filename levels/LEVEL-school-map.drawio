<mxCell id="an" value="an drying rack&lt;br&gt;Mary's moth painting: stripes purple, green, orange (clue C)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="ra"><mxGeometry x="10" y="34" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="ae" value="&lt;b&gt;ae paint cupboard — LOCKED&lt;/b&gt;&lt;br&gt;three colour dials; six pots on the shelf; slip ART/WED inside" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="ra"><mxGeometry x="170" y="34" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="as" value="as doorway + clay animals&lt;br&gt;open doorway back" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="ra"><mxGeometry x="10" y="124" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="aw" value="aw sink + three aprons&lt;br&gt;star key in the splattered apron (after note A)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="ra"><mxGeometry x="170" y="124" width="150" height="70" as="geometry"/></mxCell>

<mxCell id="rH" value="Hall" style="swimlane;startSize=24;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;" vertex="1" parent="1"><mxGeometry x="760" y="600" width="330" height="210" as="geometry"/></mxCell>
<mxCell id="hn" value="&lt;b&gt;hn stage — drawer LOCKED&lt;/b&gt;&lt;br&gt;four chime bars (sequence lock); little drawer; slip MUSIC/TUE inside" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="rH"><mxGeometry x="10" y="34" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="he" value="&lt;b&gt;he STEM cabinet — LOCKED&lt;/b&gt;&lt;br&gt;star padlock; slip SCIENCE/THU inside; house points" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="rH"><mxGeometry x="170" y="34" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="hs" value="hs doors + bench&lt;br&gt;open doors back to corridor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rH"><mxGeometry x="10" y="124" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="hw" value="hw indoor playground&lt;br&gt;stack of soft blocks hides the beater; slide" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="rH"><mxGeometry x="170" y="124" width="150" height="70" as="geometry"/></mxCell>

