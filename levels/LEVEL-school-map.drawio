<mxCell id="d6" value="doors → h1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" source="hs" target="h1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
