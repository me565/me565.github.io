<mxfile host="app.diagrams.net"><diagram name="Puzzle chart" id="chart"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Mary, packing day (version 2) — puzzle chart. Lanes read left to right: person (lilac), clue (blue), item (green), lock (red), reward (gold), the light and the people moving (grey), the ending (orange). Dotted arrows cross lanes where one trail feeds another. Retrofitted 18 Oct 2026 from the built stage." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontStyle=1" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="60" as="geometry"/></mxCell>
<mxCell id="lane0" value="Mum's brief" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="10" y="80" width="200" height="86" as="geometry"/></mxCell>
<mxCell id="card" value="The stage card: &quot;packed and zipped before the taxi. My list is on the fridge. Three things your father hid.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="230" y="80" width="250" height="86" as="geometry"/></mxCell>
<mxCell id="mum" value="Mum at the hob (n1) or the LIST on the fridge (n2): &quot;ask HIM, he is in the shower&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="250" height="86" as="geometry"/></mxCell>
