<mxfile host="app.diagrams.net"><diagram name="Puzzle chart" id="chart"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1730" pageHeight="1100"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Packing Day, from scratch (test level eval2) — puzzle chart&lt;/b&gt;&lt;br&gt;Yellow = item or gesture, blue = clue, red = lock or mechanism, green = reward, orange = a person. Three trails open at once from the whiteboard; the passport waits on the carol; the case takes all four, then the wipe. Dashed red arrows cross between lanes." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-80" width="1630" height="70" as="geometry"/></mxCell>
<mxCell id="lane_open" value="Opening (Mary&#x27;s room)" style="swimlane;horizontal=0;startSize=130;fillColor=#f3f3f3;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1630" height="150" as="geometry"/></mxCell>
<mxCell id="list" value="&lt;b&gt;CLUE&lt;/b&gt; the whiteboard by the case (m3): BEFORE THE TAXI: passport · hat + gloves · Nana&#x27;s present · the carol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_open"><mxGeometry x="145" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="gone" value="&lt;b&gt;READING&lt;/b&gt; four things gone: the empty music folder (m2), the empty desk drawer (m1), the winter box seen too high (m4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_open"><mxGeometry x="395" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="door" value="&lt;b&gt;GESTURE&lt;/b&gt; out through the door (m4), the corridor (c1 to c4), into the children&#x27;s room" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_open"><mxGeometry x="645" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="lane_A" value="A. The carol (Mary&#x27;s room ↔ Zaina)" style="swimlane;horizontal=0;startSize=130;fillColor=#e8f4f8;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="1630" height="150" as="geometry"/></mxCell>
<mxCell id="zaina" value="&lt;b&gt;PERSON&lt;/b&gt; Zaina on her bunk with the toy piano (k2): the carol sheet is in its card slot. &quot;You can have it for Shelly.&quot; She plays the VERSE: yellow, yellow, green, blue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_A"><mxGeometry x="145" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="window" value="&lt;b&gt;CLUE&lt;/b&gt; the pocket organiser under the loft (m1): a pink mermaid tail through its clear window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_A"><mxGeometry x="395" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="shelly" value="&lt;b&gt;ITEM&lt;/b&gt; Shelly the mermaid, from the organiser&#x27;s close-up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_A"><mxGeometry x="645" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="trade" value="&lt;b&gt;LOCK&lt;/b&gt; give Shelly to Zaina (k2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_A"><mxGeometry x="895" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="carol" value="&lt;b&gt;REWARD&lt;/b&gt; the carol sheet: ✓ the carol (and a clue card: two lines of coloured notes, &#x27;verse&#x27; and &#x27;everyone sings:&#x27;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_A"><mxGeometry x="1145" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="lane_B" value="B. Hat and gloves (Mary&#x27;s room)" style="swimlane;horizontal=0;startSize=130;fillColor=#fff0e6;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="1630" height="150" as="geometry"/></mxCell>
<mxCell id="high" value="&lt;b&gt;CLUE&lt;/b&gt; the wardrobe (m4): the WINTER box on the top shelf. &quot;Mary&#x27;s arms are not that long.&quot; The chair has wheels: refused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_B"><mxGeometry x="145" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="tubs" value="&lt;b&gt;MECHANISM&lt;/b&gt; under the loft&#x27;s end (m1): lift the baby bath aside, then the tub; the stool&#x27;s legs showed beneath" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_B"><mxGeometry x="395" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="stool" value="&lt;b&gt;ITEM&lt;/b&gt; the wooden step stool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_B"><mxGeometry x="645" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="reach" value="&lt;b&gt;LOCK&lt;/b&gt; stool on the wardrobe (m4): stand; the shelf close up; DRAG the ribbon&#x27;s bow open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_B"><mxGeometry x="895" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="hat" value="&lt;b&gt;REWARD&lt;/b&gt; hat and gloves: ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_B"><mxGeometry x="1145" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="lane_C" value="C. Nana&#x27;s present (both rooms)" style="swimlane;horizontal=0;startSize=130;fillColor=#e8f5e9;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="1630" height="150" as="geometry"/></mxCell>
<mxCell id="drawing" value="&lt;b&gt;ITEM&lt;/b&gt; Mary&#x27;s framed drawing on the panel under the loft (m1), labelled For Nana: &quot;it needs wrapping&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="145" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="trundle" value="&lt;b&gt;MECHANISM&lt;/b&gt; the trundle under the bunk (k2) slides open; looked into: spare bedding and a roll of snowman paper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="395" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="paper" value="&lt;b&gt;ITEM&lt;/b&gt; the wrapping paper (k2) · the tape from the pen pot on the desk (m1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="645" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="wrap" value="&lt;b&gt;LOCK&lt;/b&gt; COMBINE paper on the frame (a parcel, flaps open), then tape on the parcel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="895" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="present" value="&lt;b&gt;REWARD&lt;/b&gt; the wrapped present, To Nana: ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="1145" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="lane_D" value="D. The passport (the children&#x27;s room)" style="swimlane;horizontal=0;startSize=130;fillColor=#fdecea;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="600" width="1630" height="150" as="geometry"/></mxCell>
<mxCell id="note" value="&lt;b&gt;CLUE&lt;/b&gt; Elliot&#x27;s note on the doll&#x27;s house (k4): ZAINA&#x27;S HOUSE. KEEP OUT MARY. Password: the bit everyone sings. E." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_D"><mxGeometry x="145" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="chorus" value="&lt;b&gt;READING&lt;/b&gt; the carol sheet&#x27;s second line, &#x27;everyone sings:&#x27; blue, red, red, green (the toy piano&#x27;s key colours). Traps: the verse Zaina plays; the buttons&#x27; own order red, yellow, green, blue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_D"><mxGeometry x="395" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="buttons" value="&lt;b&gt;LOCK&lt;/b&gt; Elliot&#x27;s cardboard lock: four coloured buttons, then the tiny knob. Blue · red · red · green" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_D"><mxGeometry x="645" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="house" value="&lt;b&gt;MECHANISM&lt;/b&gt; the windows light one by one, the front swings open: the tiny bed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_D"><mxGeometry x="895" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="passport" value="&lt;b&gt;REWARD&lt;/b&gt; the passport: ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_D"><mxGeometry x="1145" y="20" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="lane_end" value="The case and the way out (Mary&#x27;s room)" style="swimlane;horizontal=0;startSize=130;fillColor=#f3f3f3;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="750" width="1630" height="150" as="geometry"/></mxCell>
<mxCell id="case" value="&lt;b&gt;LOCK&lt;/b&gt; the open case on the sofa (m3): each of the four things in; the whiteboard ticks itself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="lane_end"><mxGeometry x="895" y="20" width="220" height="110" as="geometry"/></mxCell>
