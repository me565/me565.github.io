<mxfile host="app.diagrams.net"><diagram name="Puzzle chart" id="chart"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="2000" pageHeight="1200"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Mary, last day of school, version 3 &quot;The Last Bell&quot; — puzzle chart&lt;/b&gt;&lt;br&gt;Yellow = item or gesture, blue = clue or reference, red = lock or mechanism, green = reward. Five trails open from the envelope in any order; the locker needs the four numbers and the order; the bell is the ending." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-70" width="1800" height="60" as="geometry"/></mxCell>
<mxCell id="laneM" value="Maths: Nutmeg's wheel (classroom)" style="swimlane;horizontal=0;startSize=110;fillColor=#e8f4f8;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="150" as="geometry"/></mxCell>
<mxCell id="laneS" value="Science: the blind and the stars (classroom → library → hall)" style="swimlane;horizontal=0;startSize=110;fillColor=#fff0e6;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="1800" height="150" as="geometry"/></mxCell>
<mxCell id="laneA" value="Art: mixing (art room → library)" style="swimlane;horizontal=0;startSize=110;fillColor=#e8f5e9;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="1800" height="150" as="geometry"/></mxCell>
<mxCell id="laneG" value="Geography: the route (library)" style="swimlane;horizontal=0;startSize=110;fillColor=#fff9e6;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="1800" height="150" as="geometry"/></mxCell>
<mxCell id="laneU" value="Music: the tune and the bell (library → hall)" style="swimlane;horizontal=0;startSize=110;fillColor=#fce4ec;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="600" width="1800" height="150" as="geometry"/></mxCell>
<mxCell id="laneO" value="The order and the locker (classroom → corridor)" style="swimlane;horizontal=0;startSize=110;fillColor=#ede7f6;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="750" width="1800" height="150" as="geometry"/></mxCell>
<mxCell id="laneN" value="Night Moth bonus, optional" style="swimlane;horizontal=0;startSize=110;fillColor=#f5f5f5;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="900" width="1800" height="150" as="geometry"/></mxCell>
<mxCell id="blind" value="GESTURE pull the blind up (c2): light in, the moth on the glass" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneM"><mxGeometry x="120" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="env" value="ITEM the envelope (c4): Mr Hollis's letter + five riddles" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneM"><mxGeometry x="300" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="m1" value="CLUE rule 3 on the rules poster (c4): feed Nutmeg once a day, never twice" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneM"><mxGeometry x="480" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="m2" value="MECHANISM the food tin, once: Nutmeg runs; twice: he sleeps it off" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="laneM"><mxGeometry x="660" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="m3" value="READING the wheel's counter: 7 (Maths)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneM"><mxGeometry x="840" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="s1" value="ROOM CHANGE pull the blind down (c2): the room dims" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="laneS"><mxGeometry x="480" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="s2" value="CLUE glow stars on the whiteboard wall (c1): the Kite, one star brighter" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneS"><mxGeometry x="660" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="s3" value="REFERENCE The Night Sky (ln): &quot;the Kite's brightest star is at the tail&quot;" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneS"><mxGeometry x="840" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="s4" value="LOCK star dial on the STEM cabinet (he): pick the tail star" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="laneS"><mxGeometry x="1020" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="s5" value="REWARD Science badge: 3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneS"><mxGeometry x="1200" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="a1" value="CLUE three stripes under Mary's moth (an): purple, green, orange" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneA"><mxGeometry x="480" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="a2" value="REFERENCE Ben's note (an): &quot;mixed red and blue&quot;; The Painting Book (lw): colour wheel" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneA"><mxGeometry x="660" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="a3" value="LOCK paint cupboard (ae): three dials of primary pairs → R+B, Y+B, R+Y" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="laneA"><mxGeometry x="840" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="a4" value="REWARD Art badge: 5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneA"><mxGeometry x="1020" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="g1" value="CLUE world map (le): dotted route Singapore → London, four legs N W W N" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneG"><mxGeometry x="480" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="g2" value="LOCK library cabinet (ln): four arrows" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="laneG"><mxGeometry x="660" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="g3" value="REWARD Geography badge: 2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneG"><mxGeometry x="840" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="u1" value="CLUE the banner (hn): four letters in the bar colours, read left to right: green, red, blue, yellow" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneU"><mxGeometry x="480" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="u2" value="REFERENCE Playing the Piano (lw): which bar sounds which note" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneU"><mxGeometry x="660" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="u3" value="ITEM the beater, under the soft blocks (hw)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneU"><mxGeometry x="840" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="u4" value="LOCK chime bars (hn): beater + the order" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="laneU"><mxGeometry x="1020" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="u5" value="REWARD stage drawer → the handbell" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneU"><mxGeometry x="1200" y="40" width="160" height="70" as="geometry"/></mxCell>
