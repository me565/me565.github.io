<mxfile host="app.diagrams.net"><diagram name="Puzzle chart" id="chart"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1654" pageHeight="1169"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Mary, last day of school (school) — puzzle chart&lt;/b&gt;&lt;br&gt;Every trail as item → clue → lock → reward. Yellow = item in the strip, blue = clue seen or read, red = lock (needs two kinds of input), green = reward. Trails A, B and C open together from the envelope and can be done in any order; convergence needs all three slips plus the timetable read with the whiteboard key. The Night Moth lane gates nothing." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-70" width="1620" height="60" as="geometry"/></mxCell>
<mxCell id="laneA" value="Trail A, Science (library → art room → hall)" style="swimlane;horizontal=0;startSize=110;fillColor=#e8f4f8;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1620" height="150" as="geometry"/></mxCell>
<mxCell id="laneB" value="Trail B, Music (library → hall)" style="swimlane;horizontal=0;startSize=110;fillColor=#fff0e6;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="1620" height="150" as="geometry"/></mxCell>
<mxCell id="laneC" value="Trail C, Art (library → art room)" style="swimlane;horizontal=0;startSize=110;fillColor=#e8f5e9;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="1620" height="150" as="geometry"/></mxCell>
<mxCell id="laneD" value="Convergence (classroom → corridor)" style="swimlane;horizontal=0;startSize=110;fillColor=#fff9e6;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="1620" height="150" as="geometry"/></mxCell>
<mxCell id="laneN" value="Night Moth bonus, optional (corridor → library)" style="swimlane;horizontal=0;startSize=110;fillColor=#fce4ec;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="600" width="1620" height="150" as="geometry"/></mxCell>
<mxCell id="env" value="ITEM riddle envelope&lt;br&gt;Mary's desk (c4): all three riddles at once" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneA"><mxGeometry x="120" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="a1" value="CLUE riddle 1 &quot;full of lights at night, not a city&quot; → The Night Sky, Science shelf (ln)" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneA"><mxGeometry x="300" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="a2" value="ITEM note A: &quot;the key to the stars is in my art apron, the one with the paint on it; then look for the star&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneA"><mxGeometry x="480" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="a3" value="ITEM star key&lt;br&gt;splattered apron pocket (aw); only there once note A is read" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneA"><mxGeometry x="660" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="a4" value="LOCK star padlock, STEM cabinet (he)&lt;br&gt;key + the star on the lock" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="laneA"><mxGeometry x="840" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="a5" value="REWARD slip 1: SCIENCE on THURSDAY" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneA"><mxGeometry x="1020" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="b1" value="CLUE riddle 2 &quot;eighty-eight keys, no doors&quot; → Music shelf gap + sticky note &quot;see the trolley&quot; (ln)" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneB"><mxGeometry x="300" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="b2" value="ITEM page of music, Playing the Piano on the trolley (lw): green, red, blue, yellow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneB"><mxGeometry x="480" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="b3" value="ITEM beater&lt;br&gt;under the stack of soft blocks (hw); findable any time" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneB"><mxGeometry x="660" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="b4" value="LOCK chime bars on the stage (hn)&lt;br&gt;beater + the order on the page" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="laneB"><mxGeometry x="840" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="b5" value="REWARD stage drawer slides open → slip 2: MUSIC on TUESDAY" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneB"><mxGeometry x="1020" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c1" value="CLUE riddle 3 &quot;full of colour, not a rainbow; brushes&quot; → The Painting Book, Art shelf (lw)" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneC"><mxGeometry x="300" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c2" value="ITEM note C: &quot;your slip is locked in the paint cupboard; my moth knows the colours&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneC"><mxGeometry x="480" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c3" value="CLUE three stripes under Mary's moth on the drying rack (an): purple, green, orange" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneC"><mxGeometry x="660" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c4" value="LOCK colour dials on the paint cupboard (ae)&lt;br&gt;checked only on Open" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="laneC"><mxGeometry x="840" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c5" value="REWARD slip 3: ART on WEDNESDAY" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneC"><mxGeometry x="1020" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="d1" value="CLUE timetable on the wall (c4) + the picture key on the whiteboard (c1)" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneD"><mxGeometry x="1020" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="d2" value="LOCK Mary's locker (h1): three number dials&lt;br&gt;Sci Thu = 4, Mu Tue = 3, Art Wed = 6" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="laneD"><mxGeometry x="1200" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="d3" value="REWARD report (&quot;a brilliant detective&quot;) + Nana's postcard → the last bell → postcard home" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneD"><mxGeometry x="1380" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="n1" value="CLUE bonus card on the notice board (h3): &quot;someone in London loves postcards and moths; spell her name with the first letters of four stories&quot;" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneN"><mxGeometry x="120" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="n2" value="LOCK Stories shelf (lw): pick four books in order&lt;br&gt;Nobody's Garden, A Quiet Moon, Nine Lanterns, Along the River" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="laneN"><mxGeometry x="300" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="n3" value="REWARD ★ NANA; the P.S. on the postcard home. Gates nothing." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneN"><mxGeometry x="480" y="40" width="160" height="70" as="geometry"/></mxCell>
